MARI_EXAMPLE_MODE=fake
MARI_EXAMPLE_MODEL=fixture
MARI_EXAMPLE_EMBEDDINGS=fixture
MARI_SPECULATION_THRESHOLD=0.70
MARI_CACHE_THRESHOLD=0.97
MARI_RELEVANT_DOCUMENT_THRESHOLD=0.85

